# Copy to .env and add your key (https://console.mistral.ai). Never commit .env.
MISTRAL_API_KEY=

# Ministral models read images and call tools; mistral-small/medium work too if your plan allows them.
CHAT_MODEL=ministral-14b-latest
VISION_MODEL=ministral-14b-latest
EMBED_MODEL=mistral-embed

# Local speech-to-text (faster-whisper, CPU): tiny | base | small | medium
WHISPER_MODEL=small

AGENT_MAX_STEPS=5
